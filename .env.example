BOT_TOKEN=1234567890:AAHemodiy_telegram_bot_token_example
LOG_LEVEL=INFO
REQUEST_TIMEOUT=10.0

# VirusTotal v3 API kaliti (bepul: https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=

# URLhaus API kaliti (bepul: https://auth.abuse.ch/)
URLHAUS_API_KEY=

# Google Safe Browsing v4 API kaliti (bepul: https://developers.google.com/safe-browsing/v4)
GOOGLE_SAFEBROWSING_API_KEY=

# Ma'lumotlar bazasi (SQLAlchemy async). SQLite yoki Postgres:
#   sqlite+aiosqlite:///data/safenetuz.db
#   postgresql+asyncpg://safenetuz:safenetuz@localhost:5432/safenetuz
DATABASE_URL=sqlite+aiosqlite:///data/safenetuz.db

# Redis kesh (URL/APK tahlil natijalari). Sekundlardagi TTL:
#   clean toifa uchun 24 soat, malicious uchun 30 kun
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_CLEAN=86400
CACHE_TTL_MALICIOUS=2592000

# Mirror botlar uchun webhook domeni (bo'sh bo'lsa dynamic polling ishlaydi)
MIRROR_WEBHOOK_DOMAIN=

# Boshlang'ich mirror bot tokenlari (vergul bilan ajratilgan, ixtiyoriy)
MIRROR_BOTS=

# Guruh avtomoderatsiyasi
GROUP_GUARD_BLOCK_APK=true
GROUP_GUARD_WARNING_TTL=15