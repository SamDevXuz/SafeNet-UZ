BOT_TOKEN=1234567890:AAHemodiy_telegram_bot_token_example
LOG_LEVEL=INFO
REQUEST_TIMEOUT=10.0

# VirusTotal v3 API kaliti (bepul: https://www.virustotal.com/gui/join-us)
VIRUSTOTAL_API_KEY=

# URLhaus API kaliti (bepul: https://auth.abuse.ch/)
URLHAUS_API_KEY=

# Google Safe Browsing v4 API kaliti (bepul: https://developers.google.com/safe-browsing/v4)
GOOGLE_SAFEBROWSING_API_KEY=

# Yagona SQLite baza fayli
DATABASE_PATH=data/safenetuz.db

# Mirror botlar uchun webhook domeni (bo'sh bo'lsa dynamic polling ishlaydi)
MIRROR_WEBHOOK_DOMAIN=

# Boshlang'ich mirror bot tokenlari (vergul bilan ajratilgan, ixtiyoriy)
MIRROR_BOTS=